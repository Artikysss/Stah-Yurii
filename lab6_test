import unittest
from lab6 import solve_gamsrv

class TestGamsrv(unittest.TestCase):

    def test_example_1(self):
        n, m = 6, 6
        clients = [1, 2, 6]
        edges = [
            (1, 3, 10),
            (3, 4, 8),
            (4, 5, 50),
            (5, 6, 20),
            (2, 3, 40),
            (2, 4, 100)
        ]
        result = solve_gamsrv(n, m, clients, edges)
        self.assertEqual(result, 100)

    def test_example_2(self):
        n, m = 9, 12
        clients = [2, 4, 6]
        edges = [
            (2, 4, 6),
            (1, 2, 20),
            (2, 3, 20),
            (3, 6, 20),
            (6, 9, 20),
            (9, 8, 20),
            (8, 7, 20),
            (7, 4, 20),
            (4, 1, 20),
            (5, 2, 10),
            (5, 4, 10),
            (5, 6, 10),
            (5, 8, 10)
        ]
        result = solve_gamsrv(n, m, clients, edges)
        self.assertEqual(result, 10)

    def test_isolated_client(self):
        n, m = 3, 1
        clients = [1, 3]
        edges = [(1, 2, 10)]
        result = solve_gamsrv(n, m, clients, edges)
        self.assertEqual(result, float('inf'))

if __name__ == "__main__":
    unittest.main()
