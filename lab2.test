import unittest
from lab2 import find_min_board_size

class TestLab2(unittest.TestCase):
    def test_1(self):
        self.assertEqual(find_min_board_size(10, 2, 3), 9)

    def test_2(self):
        self.assertEqual(find_min_board_size(200000000, 1000000000, 999999999), 1999999998)
#скільки ітерацій
    def test_3(self):
        self.assertEqual(find_min_board_size(4, 1, 1), 2)

unittest.main(verbosity=2, exit=False)
