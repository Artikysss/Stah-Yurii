import heapq
import sys


def solve_gamsrv(n, m, clients, edges):
    adj = [[] for _ in range(n + 1)]
    for u, v, weight in edges:
        adj[u].append((v, weight))
        adj[v].append((u, weight))

    clients_set = set(clients)
    potential_servers = [i for i in range(1, n + 1) if i not in clients_set]

    if not potential_servers:
        return 0

    min_max_latency = float("inf")

    for server_node in potential_servers:
        distances = [float("inf")] * (n + 1)
        distances[server_node] = 0
        pq = [(0, server_node)]

        while pq:
            d, u = heapq.heappop(pq)

            if d > distances[u]:
                continue

            for v, weight in adj[u]:
                if distances[u] + weight < distances[v]:
                    distances[v] = distances[u] + weight
                    heapq.heappush(pq, (distances[v], v))

        current_max = 0
        for client in clients:
            current_max = max(current_max, distances[client])

        min_max_latency = min(min_max_latency, current_max)

    return min_max_latency


