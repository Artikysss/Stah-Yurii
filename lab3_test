import unittest
    from lab3 import BinaryTree


    class TestBalancedTree(unittest.TestCase):
        def test_balanced_assignment(self):
            root = BinaryTree(1)
            root.left = BinaryTree(2)
            root.right = BinaryTree(3)
            root.left.left = BinaryTree(4)
            root.left.right = BinaryTree(5)
            self.assertTrue(root.is_balanced())

        def test_unbalanced_case(self):
            root = BinaryTree(1)
            root.left = BinaryTree(2)
            root.left.left = BinaryTree(3)
            root.left.left.left = BinaryTree(4)
            self.assertFalse(root.is_balanced())

        def test_single_node(self):
            root = BinaryTree(10)
            self.assertTrue(root.is_balanced())

        def test_tree_from_drawing(self):
            root = BinaryTree(1)
            root.left = BinaryTree(2)
            root.left.left = BinaryTree(3)

            root.right = BinaryTree(9)
            root.right.left = BinaryTree(5)
            root.right.right = BinaryTree(7)

            root.right.left.left = BinaryTree(8)
            root.right.left.right = BinaryTree(9)
            root.right.right.right = BinaryTree(10)

            self.assertTrue(root.is_balanced())


    if name == "main":
        unittest.main()
